# Cấu hình local riêng, được Git/Docker bỏ qua. VietRoute Local chủ động đọc file này.
# Khôi phục giá trị thật từ cấu hình riêng/Render; không gửi password hoặc token vào chat.
# Các giá trị REPLACE_* bên dưới là placeholder, chưa kết nối được Neon.

# Neon PostgreSQL neondb; thay host/user/password bằng cấu hình hiện có của dự án.
# pgJDBC dùng channelBinding, không dùng channel_binding của psql.
VIETROUTE_DB_URL=jdbc:postgresql://REPLACE_NEON_POOLER_HOST/neondb?sslmode=require&channelBinding=require&connectTimeout=15
VIETROUTE_DB_USER=REPLACE_DB_USER
VIETROUTE_DB_PASSWORD=REPLACE_DB_PASSWORD
VIETROUTE_DB_SCHEMA=vietroute
VIETROUTE_DB_POOL_SIZE=4
VIETROUTE_DB_ACQUIRE_TIMEOUT_MS=20000
VIETROUTE_DB_CONNECT_TIMEOUT_SECONDS=15
VIETROUTE_DB_SOCKET_TIMEOUT_SECONDS=30

VIETROUTE_ENV=development
VIETROUTE_COOKIE_SECURE=false
# Chỉ bật init/sync khi có công việc nâng cấp/khởi tạo được cho phép; không bật để rà dữ liệu.
VIETROUTE_DB_INIT_ENABLED=false
VIETROUTE_ACCESS_SYNC_ENABLED=false
VIETROUTE_ACCESS_AUDIT_RETENTION_DAYS=7
VIETROUTE_ACCESS_AUDIT_CAPACITY=1000
VIETROUTE_ACCESS_REGISTRY_CAPACITY=512
VIETROUTE_ACCESS_POLICY_CAPACITY=256
VIETROUTE_ACCESS_SCOPE_CAPACITY=512
# Điền lại khóa JWT đã cấu hình; không tạo khóa production thay thế trong lượt khôi phục file này.
VIETROUTE_JWT_SECRET=REPLACE_WITH_EXISTING_JWT_SECRET_AT_LEAST_32_BYTES
VIETROUTE_BOOTSTRAP_ADMIN_USERNAME=admin
VIETROUTE_BOOTSTRAP_ADMIN_EMAIL=hieuv526034@gmail.com
VIETROUTE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_EXISTING_BOOTSTRAP_PASSWORD

VIETROUTE_RATE_REQUESTS=300
VIETROUTE_RATE_LOGINS=20
VIETROUTE_RATE_MAX_KEYS=10000
VIETROUTE_HTTP_IN_FLIGHT=16
VIETROUTE_LOGIN_IN_FLIGHT=2
VIETROUTE_HTTP_MAX_BODY_BYTES=65536
VIETROUTE_REDIS_URL=
VIETROUTE_TRUSTED_PROXY_CIDRS=

VIETROUTE_WORKER_ENABLED=false
VIETROUTE_WORKER_THREADS=2
VIETROUTE_WORKER_POLL_SECONDS=10
VIETROUTE_WORKER_LEASE_SECONDS=180
VIETROUTE_JOB_RETENTION_DAYS=14

# SMTP local theo lựa chọn đã ghi trong tài liệu; giữ tắt tới khi có App Password hợp lệ.
# Render Free dùng Gmail HTTPS theo cấu hình triển khai riêng.
VIETROUTE_MAIL_ENABLED=false
VIETROUTE_MAIL_PROVIDER=smtp
VIETROUTE_MAIL_FROM=hieuv526034@gmail.com
VIETROUTE_GMAIL_CLIENT_ID=
VIETROUTE_GMAIL_CLIENT_SECRET=
VIETROUTE_GMAIL_REFRESH_TOKEN=
VIETROUTE_SMTP_HOST=smtp.gmail.com
VIETROUTE_SMTP_PORT=587
VIETROUTE_SMTP_USER=hieuv526034@gmail.com
VIETROUTE_SMTP_PASSWORD=

VIETROUTE_MEDIA_ENABLED=false
VIETROUTE_CLOUDINARY_CLOUD_NAME=
VIETROUTE_CLOUDINARY_API_KEY=
VIETROUTE_CLOUDINARY_API_SECRET=
VIETROUTE_CLOUDINARY_FOLDER=vietroute
VIETROUTE_HTTP_PORT=8080

VIETROUTE_METRICS_TOKEN=
VIETROUTE_MONITORING_DB_ENABLED=false
VIETROUTE_MONITORING_POLL_SECONDS=30

VIETROUTE_API_JOURNAL_ENABLED=true
VIETROUTE_API_JOURNAL_CAPACITY=10000
VIETROUTE_API_JOURNAL_MINUTES=10080
VIETROUTE_ACTIVITY_ENABLED=true
VIETROUTE_ACTIVITY_REQUEST_THRESHOLD=120

VIETROUTE_LOCAL_ENV_FILE=
VIETROUTE_AUTH_SELF_SERVICE_ENABLED=false
VIETROUTE_AUTH_REGISTRATIONS_PER_DAY=100
VIETROUTE_TRACKING_ENABLED=true

VIETROUTE_DEFAULT_ACCOUNTS_ENABLED=false
VIETROUTE_DEFAULT_CUSTOMER_EMAIL=replace_customer_email
VIETROUTE_DEFAULT_CUSTOMER_PASSWORD=replace_customer_password
VIETROUTE_DEFAULT_DRIVER_EMAIL=replace_driver_email
VIETROUTE_DEFAULT_DRIVER_PASSWORD=replace_driver_password
VIETROUTE_DEFAULT_OPERATOR_EMAIL=replace_operator_email
VIETROUTE_DEFAULT_OPERATOR_PASSWORD=replace_operator_password
VIETROUTE_BUSINESS_INIT_ENABLED=false