# Gia tri mau, khong chua credential that.

# Oracle mau: jdbc:oracle:thin:@//localhost:1521/FREEPDB1; user/schema VIETROUTE_APP.
# FREEPDB1 la SERVICE_NAME vi du, thay bang PDB service do DBA cung cap.
# Neon dung sslmode=require&channelBinding=require; pgJDBC dung channelBinding camelCase.
# LOCAL_ENV_FILE chi dat o OS/IDE hoac system property truoc khi launcher doc file.
# VIETROUTE_ENV development/production doc lap DB_VENDOR va Maven profile.

# Database: PostgreSQL dang dung; Oracle 26ai moi chuan bi JDBC, chua bat runtime.
# Vendor neu bo trong file thi suy tu JDBC URL. Khong doi DB chi bang driver.
VIETROUTE_DB_VENDOR=postgresql
VIETROUTE_DB_URL=jdbc:postgresql://localhost:5432/vietroute
VIETROUTE_DB_USER=vietroute_app
VIETROUTE_DB_PASSWORD=replace_with_your_password
VIETROUTE_DB_SCHEMA=vietroute
VIETROUTE_DB_POOL_SIZE=4
VIETROUTE_DB_ACQUIRE_TIMEOUT_MS=20000
VIETROUTE_DB_CONNECT_TIMEOUT_SECONDS=15
VIETROUTE_DB_SOCKET_TIMEOUT_SECONDS=30

# Moi truong va launcher local; OS/IDE uu tien file. WAR khong tu doc .env.
VIETROUTE_ENV=development
VIETROUTE_COOKIE_SECURE=false
VIETROUTE_HTTP_PORT=8080
VIETROUTE_LOCAL_ENV_FILE=

# JWT va admin bootstrap; tao mot lan, khong reset mat khau tai khoan da co.
VIETROUTE_JWT_SECRET=replace_with_at_least_32_random_characters
VIETROUTE_BOOTSTRAP_ADMIN_USERNAME=admin
VIETROUTE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VIETROUTE_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Khoi tao/sync chi khi chu dong bat; giu du lieu, mat khau va quyen da thu hoi.
VIETROUTE_DB_INIT_ENABLED=false
VIETROUTE_ACCESS_SYNC_ENABLED=false
VIETROUTE_DEFAULT_ACCOUNTS_ENABLED=false
VIETROUTE_BUSINESS_INIT_ENABLED=false

# Bo seed 42 tai khoan theo auth/default-access.json; cac key duoc JSON tham chieu.
# Ordinary seed: 8 ky tu toi thieu, 72 byte BCrypt toi da; khong reset account da co.
VIETROUTE_DEFAULT_CUSTOMER_EMAIL=customer@example.invalid
VIETROUTE_DEFAULT_CUSTOMER_PASSWORD=replace_with_a_strong_unique_password
VIETROUTE_DEFAULT_DRIVER_EMAIL=driver@example.invalid
VIETROUTE_DEFAULT_DRIVER_PASSWORD=replace_with_a_strong_unique_password
VIETROUTE_DEFAULT_OPERATOR_EMAIL=operator@example.invalid
VIETROUTE_DEFAULT_OPERATOR_PASSWORD=replace_with_a_strong_unique_password

# Gioi han inventory endpoint va scope, khong phai dung luong cache quyen.
VIETROUTE_ACCESS_REGISTRY_CAPACITY=512
VIETROUTE_ACCESS_SCOPE_CAPACITY=512

# Nhat ky API da loc tren PostgreSQL; retention/paging theo cau hinh duoi.
VIETROUTE_API_JOURNAL_ENABLED=true
VIETROUTE_API_JOURNAL_CAPACITY=10000
VIETROUTE_API_JOURNAL_MINUTES=10080
