# Example values only. A .env file is NOT loaded automatically by this Java application.
# Local PostgreSQL; configure these in the IDE/Tomcat run configuration.
# For Neon/Render use jdbc:postgresql://<neon-pooler-host>/neondb?sslmode=require&channelBinding=require&connectTimeout=15
# pgJDBC uses channelBinding (camelCase), unlike psql's channel_binding.
VIETROUTE_DB_URL=jdbc:postgresql://localhost:5432/vietroute
VIETROUTE_DB_USER=vietroute_app
VIETROUTE_DB_PASSWORD=replace_with_your_password
# Application schema, used by queries, metadata validation and startup migrations.
VIETROUTE_DB_SCHEMA=vietroute
# Small lazy JDBC pool; values below are the defaults. Timeouts are bounded.
VIETROUTE_DB_POOL_SIZE=4
VIETROUTE_DB_ACQUIRE_TIMEOUT_MS=20000
VIETROUTE_DB_CONNECT_TIMEOUT_SECONDS=15
VIETROUTE_DB_SOCKET_TIMEOUT_SECONDS=30

# Development defaults; set production + secure cookies on Render (see render.yaml).
VIETROUTE_ENV=development
VIETROUTE_COOKIE_SECURE=false
# Enable only when intentionally running versioned migrations + initial admin/catalog seed.
VIETROUTE_DB_INIT_ENABLED=false
VIETROUTE_JWT_SECRET=replace_with_at_least_32_random_characters
VIETROUTE_BOOTSTRAP_ADMIN_USERNAME=admin
VIETROUTE_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Traffic protection: quota per source IP/60 seconds, fail-closed when configured Redis is unavailable.
VIETROUTE_RATE_REQUESTS=300
VIETROUTE_RATE_LOGINS=20
VIETROUTE_RATE_MAX_KEYS=10000
VIETROUTE_HTTP_IN_FLIGHT=16
VIETROUTE_LOGIN_IN_FLIGHT=2
VIETROUTE_HTTP_MAX_BODY_BYTES=65536
# Redis is NOT required or enabled for the current phase. Memory quota applies per instance.
# Multiple nodes need an ingress-wide quota; do not claim the memory counter is cluster-wide.
VIETROUTE_REDIS_URL=
# Comma-separated CIDRs of actual reverse proxies, never 0.0.0.0/0. Empty ignores X-Forwarded-For.
VIETROUTE_TRUSTED_PROXY_CIDRS=

# Jobs persist in PostgreSQL even when worker is stopped; polling wakes Neon while running.
VIETROUTE_WORKER_ENABLED=false
VIETROUTE_WORKER_THREADS=2
VIETROUTE_WORKER_POLL_SECONDS=10
VIETROUTE_WORKER_LEASE_SECONDS=180
VIETROUTE_JOB_RETENTION_DAYS=14

# Gmail/Workspace via HTTPS; Render Free blocks SMTP ports. Enable after configuring OAuth + worker.
VIETROUTE_MAIL_ENABLED=false
VIETROUTE_MAIL_PROVIDER=gmail
VIETROUTE_MAIL_FROM=
VIETROUTE_GMAIL_CLIENT_ID=
VIETROUTE_GMAIL_CLIENT_SECRET=
VIETROUTE_GMAIL_REFRESH_TOKEN=
# Optional STARTTLS SMTP for local or hosting that allows outbound SMTP (Gmail App Password).
VIETROUTE_SMTP_HOST=smtp.gmail.com
VIETROUTE_SMTP_PORT=587
VIETROUTE_SMTP_USER=
VIETROUTE_SMTP_PASSWORD=

# Public images only. Cloudinary secrets stay on the server. Requires WORKER_ENABLED=true.
VIETROUTE_MEDIA_ENABLED=false
VIETROUTE_CLOUDINARY_CLOUD_NAME=
VIETROUTE_CLOUDINARY_API_KEY=
VIETROUTE_CLOUDINARY_API_SECRET=
VIETROUTE_CLOUDINARY_FOLDER=vietroute
# Local IntelliJ launcher binds 127.0.0.1; optional port (default 8080).
VIETROUTE_HTTP_PORT=8080

# Read-only Prometheus endpoint /internal/metrics. Empty disables it (404).
# Generate a random 32-256 ASCII character token; never reuse JWT secret or put it in a URL.
VIETROUTE_METRICS_TOKEN=
# Opt-in DB/queue probe; false avoids waking Neon. True samples DB every interval below.
VIETROUTE_MONITORING_DB_ENABLED=false
VIETROUTE_MONITORING_POLL_SECONDS=30

# Nhật ký API đã lọc lưu PostgreSQL, không giữ history/queue RAM; 7 ngày, mục tiêu 10000 dòng
VIETROUTE_API_JOURNAL_ENABLED=true
VIETROUTE_API_JOURNAL_CAPACITY=10000
VIETROUTE_API_JOURNAL_MINUTES=10080
