# Example values only. A .env file is NOT loaded automatically by this Java application.
# Local PostgreSQL; configure these in the IDE/Tomcat run configuration.
# For Neon/Render use jdbc:postgresql://<neon-pooler-host>/neondb?sslmode=require&channelBinding=require&connectTimeout=15
# pgJDBC uses channelBinding (camelCase), unlike psql's channel_binding.
VIETROUTE_DB_URL=jdbc:postgresql://localhost:5432/vietroute
VIETROUTE_DB_USER=vietroute_app
VIETROUTE_DB_PASSWORD=replace_with_your_password
